# ==============================================================================
# ASR 系統環境變數設定
# 請複製此檔案為 .env 並填入真實的 API 金鑰與設定
# 檔案路徑：c:\Users\LinKJ\Desktop\ASR系統\.env
# ==============================================================================

# Google Gemini API Key (可於 Google AI Studio https://aistudio.google.com/ 取得)
GEMINI_API_KEY="請在此填入你的_GEMINI_API_KEY"

# Google Drive API 相關設定 (用於 Phase 7 半自動匯入 Google Docs，初期可先留空)
GOOGLE_DRIVE_CLIENT_SECRET_FILE="credentials.json"
GOOGLE_DRIVE_FOLDER_NAME="LectureNotes"
